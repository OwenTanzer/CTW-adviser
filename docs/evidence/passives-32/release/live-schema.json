      {
        "name": "search_units",
        "description": "Search the pinned unit database with structured AND/OR filters. Enumerate rosters without guessing names. Filters precede optional mount-family grouping; each matching variant retains its own stats. Follow next_cursor with identical arguments for exhaustive results. No buffs applied. See discover_unit_fields for field/operator semantics.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "filters": {
              "$ref": "#/$defs/filter"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true
            },
            "sort": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  }
                },
                "required": [
                  "field",
                  "direction"
                ],
                "additionalProperties": false
              }
            },
            "mode": {
              "type": "string",
              "enum": [
                "variants",
                "families"
              ],
              "default": "variants"
            },
            "cursor": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          "required": [],
          "additionalProperties": false,
          "$defs": {
            "filter": {
              "description": "At most depth 5 and 32 nodes. A leaf has field/op and value or value_field; null checks omit values.",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "gte",
                        "lt",
                        "lte",
                        "in",
                        "not_in",
                        "between",
                        "contains",
                        "is_null",
                        "is_not_null"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "array"
                      ],
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "maxItems": 32
                    },
                    "value_field": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "field",
                    "op"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "and": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "$ref": "#/$defs/filter"
                      }
                    }
                  },
                  "required": [
                    "and"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "or": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "items": {
                        "$ref": "#/$defs/filter"
                      }
                    }
                  },
                  "required": [
                    "or"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
