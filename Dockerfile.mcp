FROM python:3.12-slim
WORKDIR /app
COPY . /app
RUN python scripts/fetch_locked_sources.py /tmp/ctw-source \
    && python scripts/verify_sources.py --ctw-root /tmp/ctw-source \
    && python scripts/build_snapshot.py build --ctw-root /tmp/ctw-source --output /app/ctw.sqlite \
    && python scripts/build_snapshot.py inspect /app/ctw.sqlite \
    && rm -rf /tmp/ctw-source
ENV PYTHONPATH=/app/src
EXPOSE 8080
CMD ["sh", "-c", "exec python -m ctw_adviser.mcp_http --db /app/ctw.sqlite --host 0.0.0.0 --allow-public --port ${PORT:-8080}"]
